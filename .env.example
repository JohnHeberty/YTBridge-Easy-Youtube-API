# Environment variables for YouTube API
# Copy this file to .env and configure as needed

# API Settings
APP_NAME=YouTube API
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=False

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Cache Settings
CACHE_ENABLED=True
CACHE_TYPE=memory
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Redis Settings (if using redis cache)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# YouTube API Settings
DEFAULT_TIMEOUT=10
MAX_VIDEOS_PER_REQUEST=100
MAX_SEARCH_RESULTS=50

# CORS Settings (comma-separated origins)
# CORS_ORIGINS=*
